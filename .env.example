SEOUL_API_KEY=여기에_열린데이터광장_인증키
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=여기에_service_role_키

# 본인 이용내역용. 브라우저에서 로그인한 뒤 개발자도구 →
# Application → Cookies에서 JSESSIONID 값을 통째로 복사해 넣는다
# (뒤의 .spbSvcWebN 접미사까지). 만료되면 다시 갱신한다.
BIKESEOUL_SESSION=

# 스케줄러 구축·점검용 Postgres 직접 접속. 확장 설치와 함수·크론잡 생성은
# DDL이라 REST API로는 못 한다. Supabase 대시보드 > Settings > Database >
# Connection string (Session pooler) 에서 복사하고 [YOUR-PASSWORD]를 실제
# 비밀번호로 바꾼다. 평상시 적재에는 필요 없다.
SUPABASE_DB_URL=
